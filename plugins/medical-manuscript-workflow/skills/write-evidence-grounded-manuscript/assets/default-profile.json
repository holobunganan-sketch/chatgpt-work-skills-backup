{
  "profile_name": "default-biomedical-manuscript",
  "structure": {
    "required_sections": [
      "Abstract",
      "Introduction",
      "Methods",
      "Results",
      "Discussion",
      "Conclusion",
      "Declarations",
      "References"
    ],
    "abstract_labels": [
      "Background",
      "Objective",
      "Methods",
      "Results",
      "Conclusions"
    ],
    "subsections_allowed_in": ["Methods", "Results"],
    "max_markdown_heading_level": 3,
    "conclusion_paragraphs": 1,
    "title_page": false
  },
  "methods_results": {
    "policy": "pre-analysis-test",
    "realized_counts_in_results": true,
    "numeric_policy": "prespecified-only",
    "empirical_assets_section": "Results"
  },
  "citations": {
    "style": "AMA 11th",
    "reference_manager": "Zotero",
    "external_citations_allowed_in": ["Introduction", "Discussion"],
    "method_citations_require_override": true
  },
  "discussion": {
    "require_finding_synthesis_first_paragraph": true,
    "final_paragraph": {
      "required": true,
      "limitation_count": 3,
      "require_paired_future_improvements": true,
      "require_explicit_transitions": true,
      "single_paragraph": true
    }
  },
  "document": {
    "font_family": "Times New Roman",
    "font_size_pt": 12,
    "text_color": "000000",
    "line_spacing": 1.5,
    "figure_caption_position": "below",
    "table_title_position": "above",
    "figure_caption_alignment": "center",
    "table_title_alignment": "center",
    "output_format": "docx"
  },
  "quality": {
    "require_number_traceability": true,
    "require_asset_citation_before_insertion": true,
    "require_figure_caption_same_page": true,
    "require_docx_integrity_check": true,
    "require_visual_render_check": true,
    "require_real_zotero_fields_when_requested": true
  }
}
