{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/medical-manuscript-workflow/release-report.schema.json",
  "title": "Internal release report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "created_at", "release_ready", "gates", "issues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "release_ready": {"type": "boolean"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "issue_count"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "issue_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
