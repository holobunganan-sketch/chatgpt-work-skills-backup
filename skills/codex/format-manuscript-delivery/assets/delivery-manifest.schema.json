{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "论文正式交付文件登记",
  "type": "object",
  "required": ["schema_version", "manuscript", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manuscript": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "label", "path"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "figure",
              "table",
              "supplementary_figure",
              "supplementary_table",
              "supplementary_material",
              "submission_checklist"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
